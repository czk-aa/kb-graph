# ===== 基础 =====
DEBUG=false

# 数据库 / Redis（docker compose 内自动覆盖，本地开发按需修改）
DATABASE_URL=postgresql+asyncpg://kb:kb123456@localhost:5432/kb
REDIS_URL=redis://localhost:6379/0
DB_PASSWORD=kb123456

# JWT
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRE_HOURS=24

# LLM（OpenAI 兼容 API：DeepSeek / Qwen / Ollama 等）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# Embedding（独立于 LLM；DeepSeek 不提供 embedding，可用 Qwen/Ollama bge-m3）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# 检索
SEARCH_TOP_K=20
RETRIEVE_CONTEXT_K=8
