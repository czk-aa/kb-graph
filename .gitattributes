# Auto-detect text files, normalize to LF in the repo
* text=auto

# Source code (always LF)
*.py text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.env text eol=lf
*.md text eol=lf
*.mako text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.conf text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.lock binary